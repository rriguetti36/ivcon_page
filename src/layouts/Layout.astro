---
import empresa from '../data/empresa.json';
import { asset } from '../lib/media';
import { absoluteUrl, indexable, organizationSchema, breadcrumbSchema } from '../lib/seo';
import '../styles/global.css';
import '../styles/fonts.css';
const { title, description, noindex = false, breadcrumbs = [], schemas = [], canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = canonicalPath ? absoluteUrl(canonicalPath) : null;
const logo = asset(['logo-web.webp', 'logo-recortado.png', 'logo.png']);
const socialImage = absoluteUrl('/imagenes/ivcon-social.jpg');
const schema = { '@context': 'https://schema.org', '@graph': [organizationSchema, ...(breadcrumbs.length > 1 ? [breadcrumbSchema(breadcrumbs)] : []), ...schemas] };
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <meta name="robots" content={!indexable ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="es_PE" /><meta property="og:site_name" content="IVCON EIRL" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="IVCON EIRL — impermeabilización en Lima y Perú" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content="Logo de IVCON EIRL" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#122628" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <div class="topbar"><div class="container"><span>IMPERMEABILIZACIÓN ESPECIALIZADA</span><span>Lima · Sierra · Selva · Todo el Perú ↗</span></div></div>
    <header><div class="container nav"><a class="brand header-brand" href="/" aria-label="IVCON inicio">{logo ? <img src={logo} alt="IVCON" width="720" height="265" fetchpriority="high" /> : <span>IVCON<span class="brand-dot">.</span></span>}<small>INGENIERÍA QUE PROTEGE</small></a><nav class="desktop-nav" aria-label="Principal"><a href="/servicios/">Soluciones</a><a href="/#sistemas">Sistemas</a><a href="/proyectos/">Proyectos</a><a href="/#cobertura">Cobertura</a></nav><a class="button small" href="/#contacto">Evaluar mi proyecto <span>↗</span></a><details class="mobile-menu"><summary aria-label="Menú principal">Menú <span>☰</span></summary><nav aria-label="Principal móvil"><a href="/servicios/">Soluciones</a><a href="/#sistemas">Sistemas</a><a href="/proyectos/">Proyectos</a><a href="/#cobertura">Cobertura</a><a href="/#contacto">Evaluar mi proyecto ↗</a></nav></details></div></header>
    <main id="contenido"><slot /></main>
    <footer><div class="container footer-grid"><div><a class="brand light" href="/">IVCON<span class="brand-dot">.</span></a><p>Impermeabilización de techos en Lima y Perú.<br />Protección que empieza con una buena evaluación.</p></div><div><strong>Conversemos sobre tu proyecto</strong><p>{empresa.nombre}<br />{empresa.zona}</p>{empresa.telefono && <a href={`tel:${empresa.telefono.replace(/\s/g,'')}`}>{empresa.telefono}</a>}{empresa.correo && <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>}</div><div><strong>Encuéntranos</strong>{empresa.direccion && <p>{empresa.direccion}</p>}{empresa.horarios && <p>{empresa.horarios}</p>}{empresa.googleMaps && <a href={empresa.googleMaps} target="_blank" rel="noopener noreferrer">Ver en Google Maps ↗</a>}<a href="/#contacto">Solicitar evaluación ↗</a></div></div><div class="container copyright">© {new Date().getFullYear()} IVCON EIRL. Todos los derechos reservados.<span>Hecho para proteger lo que construyes.</span></div></footer>
  </body>
</html>
<script>
const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
});
document.addEventListener('click', event => { if (menu?.open && !menu.contains(event.target as Node)) menu.open = false; });
</script>
