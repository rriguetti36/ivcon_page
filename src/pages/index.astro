---
import Layout from '../layouts/Layout.astro';
import proyectos from '../data/proyectos.json';
import empresa from '../data/empresa.json';
import { asset, photos } from '../lib/media';
const banner = asset(['banner.webp','banner.jpg','banner.png','portada.jpg']);
const video = asset(['banner.mp4','banner.webm']);
const whatsapp = empresa.whatsapp.replace(/\D/g,'');
const services = [
  ['01','Techos y azoteas','Impermeabilización de techos en Lima y Perú: evaluamos filtraciones, goteras y humedad para definir la preparación de la superficie y el sistema adecuado.','Techos de viviendas · Azoteas · Edificios'],
  ['02','Terrazas y áreas transitables','La impermeabilización de terrazas necesita considerar el uso, los encuentros y la protección del sistema frente al tránsito peatonal.','Terrazas · Áreas comunes · Zonas de paso'],
  ['03','Cubiertas e infraestructura','Impermeabilización industrial en Perú y atención a proyectos de salud, educación e infraestructura, según las condiciones de cada obra.','Cubiertas industriales · Hospitales · Obras públicas']
];
const systems = [ ['Manto asfáltico','Membranas SBS / APP','Instalación de manto asfáltico para techos, con alternativas de 3 mm y 4 mm. La elección depende del soporte, la exposición y las especificaciones de la obra.'], ['Membranas líquidas','Continuidad y adaptación','Una alternativa para geometrías y detalles que requieren un sistema continuo. Se evalúan compatibilidad, consumo, refuerzos y condiciones de aplicación.'], ['Sistemas protegidos','Tránsito y uso industrial','Soluciones para tránsito peatonal y cubiertas industriales, considerando la protección, los puntos singulares y el mantenimiento requerido.'] ];
---
<Layout title="Impermeabilización de Techos en Perú | Manto Asfáltico | IVCON" description="Impermeabilización de techos, azoteas y terrazas en Lima y Perú. Manto asfáltico y membranas líquidas para filtraciones, humedad y goteras. Solicita una evaluación.">
  <section class:list={['hero', { 'has-media': banner || video }]}>
    {video ? <video class="hero-media" autoplay muted loop playsinline poster={banner || undefined} aria-hidden="true"><source src={video} /></video> : banner && <img class="hero-media" src={banner} alt="" fetchpriority="high" />}
    <div class="hero-lines" aria-hidden="true"></div>
    <div class="container hero-content"><div class="eyebrow"><span class="status-dot"></span> ESPECIALISTAS EN IMPERMEABILIZACIÓN</div><h1>La lluvia no se detiene.<br /><em>Las filtraciones, sí.</em></h1><p>Impermeabilización de techos en Lima y Perú.<br />Manto asfáltico y membranas líquidas para proteger tu obra de la humedad, las goteras y las lluvias intensas.</p><div class="hero-actions"><a class="button" href="#contacto">Solicitar una evaluación <span>↗</span></a><a class="text-link" href="#servicios">Encuentra tu solución <span>↓</span></a></div><div class="hero-note">VIVIENDAS <span> / </span> EDIFICIOS <span> / </span> INDUSTRIA <span> / </span> INFRAESTRUCTURA</div></div>
    <div class="hero-bottom container"><span>PROTECCIÓN DESDE LA SUPERFICIE.</span><span>01 — IMPERMEABILIZACIÓN</span></div>
  </section>
  <section class="stats container" aria-label="Experiencia IVCON"><div><strong>250 mil <span>m²</span></strong><p>instalados</p></div><div><strong>12 <span>años</span></strong><p>de experiencia</p></div><div><strong>25 <span>regiones</span></strong><p>alcance nacional</p></div><div class="stats-message">Experiencia en obra.<br /><b>Protección para tu inversión.</b></div></section>
  <section id="servicios" class="section container"><div class="section-heading"><div><div class="eyebrow orange">01 / SOLUCIONES</div><h2>Un techo seco.<br />Un problema menos.</h2></div><p>¿Aparecieron manchas de humedad o goteras? La reparación de filtraciones en techos empieza por identificar por dónde ingresa el agua y qué está fallando.</p></div><div class="service-grid">{services.map(([n,title,text,tags]) => <article class="service-card"><span class="card-number">{n} /</span><div class="roof-icon" aria-hidden="true">⌂</div><h3>{title}</h3><p>{text}</p><small>{tags}</small><a href="#contacto">Evaluar esta superficie <span>↗</span></a></article>)}</div></section>
  <section id="sistemas" class="systems section"><div class="container"><div class="section-heading"><div><div class="eyebrow">02 / CRITERIO TÉCNICO</div><h2>El sistema correcto.<br />Para cada superficie.</h2></div><p>Una empresa de impermeabilización debe evaluar antes de proponer. Elegimos el sistema según el estado del soporte, la exposición a lluvia y el uso del techo.</p></div><div class="systems-grid">{systems.map(([title,tag,text],i) => <article><div class={`layers layer-${i}`} aria-hidden="true"><i></i><i></i><i></i></div><span class="eyebrow">{tag}</span><h3>{title}</h3><p>{text}</p></article>)}</div><div class="technical-note"><span>LA DIFERENCIA ESTÁ EN LOS DETALLES</span><p>Preparación del soporte, pendientes, desagües, juntas y encuentros: la evaluación considera el conjunto, además del material.</p></div></div></section>
  <section class="section container" id="proyectos"><div class="section-heading"><div><div class="eyebrow orange">03 / EXPERIENCIA EN CAMPO</div><h2>Obras que exigen<br />hacerlo bien.</h2></div><p>Conoce los proyectos de IVCON en infraestructura, salud, educación y vivienda. Cada obra tiene condiciones distintas y merece una solución específica.</p></div><div class="project-grid">{proyectos.map((p,i) => {const cover=photos(p.slug)[0];return <a class="project-card" href={`/proyectos/${p.slug}/`}><div class={`project-image project-${i % 3}`}>{cover ? <img src={cover} alt={p.nombre} loading="lazy" width="640" height="420" /> : <div class="project-drawing" aria-hidden="true"><span>{String(i+1).padStart(2,'0')}</span><i></i></div>}<span class="project-sector">{p.sector}</span><span class="project-arrow">↗</span></div><small>{p.ubicacion}</small><h3>{p.nombre}</h3></a>})}</div></section>
  <section class="coverage" id="cobertura"><div class="container coverage-grid"><div><div class="eyebrow orange">04 / DONDE TU OBRA NOS NECESITE</div><h2>De Lima a la sierra.<br />De la sierra a la selva.</h2><p>Trabajamos en las 25 regiones del Perú, con especial enfoque en proyectos de la sierra y la selva expuestos a lluvias intensas.</p><p>Para la impermeabilización de azoteas en Lima o una cubierta en San Martín, evaluamos el clima, la superficie y la logística de ejecución de cada proyecto.</p><a class="text-link dark" href="#contacto">Consultar atención en mi ciudad ↗</a></div><div class="region-panel"><div><span>01</span><h3>Lima y costa</h3><p>Techos, azoteas y terrazas.</p></div><div><span>02</span><h3>Sierra</h3><p>Protección frente a temporadas de lluvia.</p></div><div><span>03</span><h3>Selva</h3><p>Evaluación para humedad y lluvias intensas.</p></div></div></div></section>
  <section class="section container"><div class="section-heading"><div><div class="eyebrow orange">05 / ASÍ TRABAJAMOS</div><h2>Primero evaluamos.<br />Después protegemos.</h2></div><p>Una propuesta clara permite conocer el alcance, el sistema y las condiciones de garantía antes de iniciar.</p></div><div class="steps">{[['01','Evaluación','Revisamos el problema, la superficie, los desagües y el uso del área.'],['02','Propuesta técnica','Definimos solución, sistema utilizado, alcance y condiciones de ejecución.'],['03','Instalación','Preparamos el soporte y atendemos los detalles del sistema seleccionado.'],['04','Entrega y garantía','Acordamos las condiciones de garantía y las recomendaciones de mantenimiento.']].map(([n,t,d])=><article><span>{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></section>
  <section class="faq section"><div class="container faq-grid"><div><div class="eyebrow orange">RESOLVEMOS TUS DUDAS</div><h2>Antes de<br />impermeabilizar.</h2></div><div>{[['¿Manto asfáltico o membrana líquida?','Depende del estado y tipo de superficie, su uso y las condiciones de exposición. La evaluación permite determinar qué sistema es compatible y cómo debe instalarse.'],['¿Se puede reparar solo la zona de una gotera?','Primero hay que localizar el origen. El agua puede desplazarse antes de aparecer dentro del inmueble; la evaluación define si corresponde una reparación puntual o una intervención más amplia.'],['¿Cuánto cuesta la instalación de manto asfáltico en Lima?','La cotización depende del área, el estado del soporte, el sistema, los accesos y los detalles de la cubierta. Comparte la ubicación, las medidas aproximadas y fotografías para iniciar la evaluación.'],['¿Qué garantía tiene la impermeabilización?','La duración, cobertura y condiciones de garantía deben quedar indicadas en la propuesta de cada proyecto, según el sistema y el alcance contratado.'],['¿Atienden fuera de Lima?','Sí. IVCON atiende proyectos en las 25 regiones del Perú, incluidos proyectos en la sierra y selva. La programación se coordina según la ubicación y el alcance.']].map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
  <section class="contact section" id="contacto"><div class="container contact-grid"><div><div class="eyebrow">HABLEMOS DE TU PROYECTO</div><h2>Que la próxima lluvia<br />no te tome por sorpresa.</h2><p>Cuéntanos dónde está tu obra y qué necesitas proteger. Empecemos por una evaluación.</p><div class="contact-facts"><strong>IVCON EIRL</strong><span>Impermeabilización de techos en Lima y Perú</span><span>{empresa.zona}</span>{empresa.telefono && <a href={`tel:${empresa.telefono.replace(/\s/g,'')}`}>{empresa.telefono}</a>}{empresa.correo && <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>}{empresa.horarios && <span>{empresa.horarios}</span>}</div></div><form id="inquiry" data-whatsapp={whatsapp} data-email={empresa.correo}><h3>Solicita tu evaluación</h3><label>Tu nombre<input name="nombre" required maxlength="100" autocomplete="name" placeholder="¿Cómo te llamas?" /></label><div class="form-row"><label>Ciudad o región<input name="ciudad" required maxlength="120" placeholder="Ej. Tarapoto, San Martín" /></label><label>Superficie<select name="superficie"><option>Techo o azotea</option><option>Terraza</option><option>Cubierta industrial</option><option>Otro proyecto</option></select></label></div><label>¿Qué ocurre en tu proyecto?<textarea name="detalle" required maxlength="2000" rows="3" placeholder="Filtraciones, goteras, área aproximada…"></textarea></label><button class="button" type="submit">{whatsapp ? 'Consultar por WhatsApp' : empresa.correo ? 'Preparar consulta por correo' : 'Preparar consulta'} <span>↗</span></button><p class="form-note">{whatsapp ? 'Se abrirá WhatsApp con tu consulta. Tú decides cuándo enviarla.' : empresa.correo ? 'Se abrirá tu aplicación de correo para revisar y enviar la consulta.' : 'El canal de contacto estará disponible próximamente. Puedes preparar y copiar tu consulta.'}</p><div id="form-result" role="status" hidden><p id="form-status"></p><textarea id="prepared-message" readonly aria-label="Consulta preparada" rows="6"></textarea></div></form></div></section>
</Layout>
<script>
const form = document.querySelector<HTMLFormElement>('#inquiry');
form?.addEventListener('submit', (event) => {event.preventDefault();const data = new FormData(form);const message = `Hola IVCON, solicito una evaluación.\nNombre: ${data.get('nombre')}\nUbicación: ${data.get('ciudad')}\nSuperficie: ${data.get('superficie')}\nConsulta: ${data.get('detalle')}`;if(form.dataset.whatsapp) {window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(message)}`, '_blank','noopener,noreferrer');} else if(form.dataset.email) {window.location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent('Solicitud de evaluación')}&body=${encodeURIComponent(message)}`;} else {const result=document.querySelector<HTMLElement>('#form-result')!;result.hidden=false;document.querySelector('#form-status')!.textContent='Consulta preparada. Aún no se ha enviado; copia el texto para conservarlo.';document.querySelector<HTMLTextAreaElement>('#prepared-message')!.value=message;}});
</script>
